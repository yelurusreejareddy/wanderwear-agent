# Copy this file to .env and paste your real keys in. .env is gitignored,
# never committed, these are examples/placeholders only.

# Free key at https://console.groq.com/keys (no credit card required).
LLM_API_KEY=paste_your_groq_key_here
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b

# Free project at https://supabase.com (no credit card required).
SUPABASE_URL=paste_your_supabase_project_url_here
# The public, "publishable" key, safe to embed in client-side code like
# review.html, real protection comes from the real RLS policies on
# each table/bucket, not from keeping this one secret.
SUPABASE_KEY=paste_your_supabase_publishable_key_here
# The real, privileged key. Only ever used by real backend code
# (agent/photo_access.py), never a browser, never a client-side file,
# never committed. From Supabase's dashboard, Settings -> API ->
# "Legacy anon, service_role API keys" tab -> service_role.
SUPABASE_SERVICE_KEY=paste_your_supabase_service_role_key_here
